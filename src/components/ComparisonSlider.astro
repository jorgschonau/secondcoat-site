---
interface ImageAsset {
  src: string;
  srcWebp: string;
  width: number;
  height: number;
  alt: string;
}

interface Props {
  id: string;
  number: string;
  label?: string;
  lines: string[];
  before: ImageAsset;
  after: ImageAsset;
  aspectRatio: string;
  objectPosition?: string;
  priority?: boolean;
  /** Percent of stage showing the enhanced (after) image. Default 55. */
  afterPercent?: number;
  /** Used for aria when label is omitted (e.g. group title). */
  ariaName?: string;
  /** Larger stage for the lead showcase item */
  featured?: boolean;
}

const {
  id,
  number,
  label = '',
  lines,
  before,
  after,
  aspectRatio,
  objectPosition = 'center center',
  priority = false,
  afterPercent = 55,
  ariaName,
  featured = false,
} = Astro.props;

const dividerPercent = 100 - afterPercent;
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : 'auto';
const aspectNumeric = after.width / after.height;
const accessibleName = ariaName || label || 'Comparison';
---

<figure
  class:list={['comparison', featured && 'comparison--featured']}
  data-comparison
  style={`--aspect:${aspectRatio}; --ar:${aspectNumeric}; --object-pos:${objectPosition}; --pos:${dividerPercent}%;`}
>
  <figcaption class="comparison__caption">
    <div class="comparison__meta">
      <span class="label">{number}</span>
      {label ? <h3 class="comparison__title">{label}</h3> : null}
    </div>
    <p class="comparison__lines">
      {lines.map((line, i) => (
        <>
          {line}{i < lines.length - 1 && <br />}
        </>
      ))}
    </p>
  </figcaption>

  <div
    class="comparison__stage"
    data-stage
    role="group"
    aria-roledescription="before and after image comparison"
    aria-label={`${accessibleName}: drag or use arrow keys to compare original and restored`}
  >
    <div class="comparison__media comparison__media--after" aria-hidden="true">
      <picture>
        <source srcset={after.srcWebp} type="image/webp" />
        <img
          src={after.src}
          width={after.width}
          height={after.height}
          alt=""
          loading={loading}
          decoding="async"
          fetchpriority={fetchpriority}
          sizes="(max-width: 900px) 94vw, min(88rem, 90vw)"
        />
      </picture>
    </div>

    <div class="comparison__media comparison__media--before" data-before aria-hidden="true">
      <picture>
        <source srcset={before.srcWebp} type="image/webp" />
        <img
          src={before.src}
          width={before.width}
          height={before.height}
          alt=""
          loading={loading}
          decoding="async"
          fetchpriority={fetchpriority}
          sizes="(max-width: 900px) 94vw, min(88rem, 90vw)"
        />
      </picture>
    </div>

    <div class="comparison__labels" aria-hidden="true">
      <span class="comparison__badge">Before</span>
      <span class="comparison__badge">After</span>
    </div>

    <div class="comparison__divider" data-divider aria-hidden="true">
      <span class="comparison__handle"></span>
    </div>

    <label class="sr-only" for={`compare-${id}`}>Comparison position between original and restored</label>
    <input
      class="comparison__range"
      id={`compare-${id}`}
      data-range
      type="range"
      min="0"
      max="100"
      value={String(dividerPercent)}
      step="1"
      aria-valuemin={0}
      aria-valuemax={100}
      aria-valuenow={dividerPercent}
      aria-valuetext={`${afterPercent}% restored, ${dividerPercent}% original`}
      aria-label="Reveal original versus restored image"
    />
  </div>

  <details class="comparison__alt">
    <summary>View images separately</summary>
    <div class="comparison__alt-grid">
      <figure>
        <picture>
          <source srcset={before.srcWebp} type="image/webp" />
          <img
            src={before.src}
            width={before.width}
            height={before.height}
            alt={before.alt}
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="label">Before</figcaption>
      </figure>
      <figure>
        <picture>
          <source srcset={after.srcWebp} type="image/webp" />
          <img
            src={after.src}
            width={after.width}
            height={after.height}
            alt={after.alt}
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="label">After</figcaption>
      </figure>
    </div>
  </details>
</figure>

<script>
  function initComparison(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-stage]');
    const before = root.querySelector<HTMLElement>('[data-before]');
    const divider = root.querySelector<HTMLElement>('[data-divider]');
    const range = root.querySelector<HTMLInputElement>('[data-range]');
    if (!stage || !before || !divider || !range) return;

    let dragging = false;

    const setDivider = (percentFromLeft: number) => {
      const clamped = Math.min(100, Math.max(0, percentFromLeft));
      const rounded = Math.round(clamped);
      root.style.setProperty('--pos', `${clamped}%`);
      range.value = String(rounded);
      range.setAttribute('aria-valuenow', String(rounded));
      const afterPct = 100 - rounded;
      range.setAttribute(
        'aria-valuetext',
        `${afterPct}% restored, ${rounded}% original`,
      );
    };

    const fromClientX = (clientX: number) => {
      const rect = stage.getBoundingClientRect();
      if (rect.width <= 0) return;
      setDivider(((clientX - rect.left) / rect.width) * 100);
    };

    range.addEventListener('input', () => setDivider(Number(range.value)));

    stage.addEventListener('pointerdown', (event: PointerEvent) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      if ((event.target as HTMLElement).closest('input')) return;
      dragging = true;
      stage.setPointerCapture(event.pointerId);
      fromClientX(event.clientX);
    });

    stage.addEventListener('pointermove', (event: PointerEvent) => {
      if (!dragging) return;
      fromClientX(event.clientX);
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      if (stage.hasPointerCapture(event.pointerId)) {
        stage.releasePointerCapture(event.pointerId);
      }
    };

    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);
  }

  const boot = () => {
    document.querySelectorAll<HTMLElement>('[data-comparison]').forEach(initComparison);
  };

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .comparison {
    display: grid;
    gap: var(--space-md);
  }

  .comparison__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    align-items: end;
  }

  .comparison__meta {
    display: grid;
    gap: 0.45rem;
  }

  .comparison__title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .comparison__lines {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--color-ink-muted);
    text-align: right;
    max-width: 28rem;
  }

  .comparison__stage {
    --stage-max-h: min(78vh, 46rem);
    position: relative;
    aspect-ratio: var(--aspect);
    /* Keep true image proportions when max-height binds (critical on mobile) */
    width: min(100%, calc(var(--stage-max-h) * var(--ar)));
    max-height: var(--stage-max-h);
    height: auto;
    margin-inline: auto;
    overflow: hidden;
    background: #0c0c0a;
    border: 1px solid var(--color-rule);
    touch-action: none;
    user-select: none;
    cursor: col-resize;
  }

  .comparison--featured .comparison__stage {
    --stage-max-h: min(86vh, 54rem);
  }

  .comparison__media {
    position: absolute;
    inset: 0;
  }

  .comparison__media picture,
  .comparison__media img {
    width: 100%;
    height: 100%;
  }

  .comparison__media img {
    object-fit: contain;
    object-position: var(--object-pos);
    pointer-events: none;
  }

  /* Keep low-res originals crisp when scaled up */
  .comparison__media--before img {
    image-rendering: pixelated;
  }

  .comparison__media--after img {
    image-rendering: auto;
  }

  .comparison__media--before {
    z-index: 2;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .comparison__labels {
    position: absolute;
    inset: 0.85rem;
    z-index: 4;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .comparison__badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: rgba(19, 18, 16, 0.78);
    border: 1px solid var(--color-rule-strong);
    padding: 0.35rem 0.5rem;
  }

  .comparison__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    z-index: 5;
    width: 1px;
    background: var(--color-ink);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .comparison__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.35rem;
    height: 2.35rem;
    transform: translate(-50%, -50%);
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    background: rgba(19, 18, 16, 0.88);
  }

  .comparison__handle::before,
  .comparison__handle::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.35rem;
    height: 0.35rem;
    border-top: 1px solid var(--color-ink);
    border-right: 1px solid var(--color-ink);
  }

  .comparison__handle::before {
    left: 0.55rem;
    transform: translateY(-50%) rotate(-135deg);
  }

  .comparison__handle::after {
    right: 0.55rem;
    transform: translateY(-50%) rotate(45deg);
  }

  .comparison__range {
    position: absolute;
    inset: 0;
    z-index: 6;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: col-resize;
    appearance: none;
    -webkit-appearance: none;
  }

  .comparison__alt {
    border-top: 1px solid var(--color-rule);
    padding-top: 0.75rem;
  }

  .comparison__alt summary {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    cursor: pointer;
    width: fit-content;
  }

  .comparison__alt summary:hover {
    color: var(--color-ink-muted);
  }

  .comparison__alt-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 700px) {
    .comparison__alt-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .comparison__alt-grid figure {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .comparison__alt-grid img {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-rule);
  }

  @media (max-width: 700px) {
    .comparison {
      /* Use full viewport width so landscape stages aren’t tiny inside page pad */
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }

    .comparison__caption {
      padding-inline: var(--page-pad);
    }

    .comparison__lines {
      text-align: left;
      width: 100%;
    }

    .comparison__stage {
      --stage-max-h: min(92vh, 52rem);
      width: min(100%, calc(var(--stage-max-h) * var(--ar)));
      border-left: 0;
      border-right: 0;
    }

    .comparison--featured .comparison__stage {
      --stage-max-h: min(94vh, 56rem);
    }

    .comparison__alt {
      padding-inline: var(--page-pad);
    }

    .comparison__handle {
      width: 2.75rem;
      height: 2.75rem;
    }

    .comparison__labels {
      inset: 0.65rem;
    }
  }
</style>
