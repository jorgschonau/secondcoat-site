---
import { SITE } from '../data/site';
---

<header class="masthead">
  <div class="masthead__inner">
    <a class="masthead__brand" href="/" aria-label="Second Coat home">
      <img
        class="masthead__mark"
        src="/brand/controller-mark.png"
        width="583"
        height="361"
        alt=""
        decoding="async"
      />
      <span class="masthead__wordmark" aria-hidden="true">
        <span class="masthead__wordmark-name">secondcoat</span><span class="masthead__wordmark-tld">.games</span>
      </span>
    </a>
    <nav class="masthead__nav" aria-label="Primary">
      <a href="/#work">Work</a>
      <a href="/#approach">Approach</a>
      <a href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-bg);
  }

  .masthead__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    max-width: 88rem;
    margin-inline: auto;
    padding-inline: var(--page-pad);
  }

  .masthead__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    min-width: 0;
  }

  .masthead__mark {
    display: block;
    height: 36px;
    width: auto;
    flex-shrink: 0;
  }

  .masthead__wordmark {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  .masthead__wordmark-name {
    color: var(--color-ink);
  }

  .masthead__wordmark-tld {
    color: var(--color-brand);
  }

  .masthead__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
  }

  .masthead__nav a {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink-muted);
    transition: color var(--duration) var(--ease);
  }

  .masthead__nav a:hover {
    color: var(--color-ink);
  }

  @media (max-width: 700px) {
    .masthead__mark {
      height: 28px;
    }

    .masthead__wordmark {
      font-size: 0.82rem;
    }

    .masthead__brand {
      gap: 0.55rem;
    }
  }
</style>
