---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ComparisonSlider from '../../components/ComparisonSlider.astro';
import { SITE } from '../../data/site';
import { getWorkBySlug } from '../../data/work';

const project = getWorkBySlug('alpha-centauri');
if (!project) {
  throw new Error('Missing alpha-centauri project data');
}
---

<BaseLayout
  title={`${project.title.replace('\n', ' ')} — ${SITE.name}`}
  description="Unofficial visual restoration study of Sid Meier’s Alpha Centauri, demonstrating the Second Coat process."
  canonicalPath="/work/alpha-centauri"
>
  <Header />
  <main id="main" class="section section--loose">
    <div class="page-shell--wide stack-xl">
      <header class="stack-lg">
        <p class="label">
          <a href="/#work">← Selected Work</a>
          &nbsp;/&nbsp;
          {project.number}
        </p>
        <h1 class="display-lg">
          {project.title.split('\n').map((line, i, arr) => (
            <>
              {line}
              {i < arr.length - 1 && <br />}
            </>
          ))}
        </h1>
        <div class="meta">
          <span class="label label--ink">{project.years}</span>
          <span class="label">{project.statusLabel}</span>
        </div>
        <div class="prose prose--tight">
          {project.summary.map((para) => <p>{para}</p>)}
        </div>
        <p class="display-md question">
          {project.question.map((line, i, arr) => (
            <>
              {line}
              {i < arr.length - 1 && <br />}
            </>
          ))}
        </p>
        <p class="disclaimer">{project.disclaimer}</p>
      </header>

      <div class="stack-comparisons">
        {
          project.comparisonGroups.map((group, groupIndex) => (
            <section class="group stack-xl" aria-labelledby={`page-group-${group.id}`}>
              <header class="group__header">
                <span class="label">{group.number}</span>
                <h2 id={`page-group-${group.id}`} class="group__title">
                  {group.title}
                </h2>
              </header>
              <div class="group__items">
                {group.items.map((pair, index) => (
                  <ComparisonSlider
                    id={`page-${pair.id}`}
                    number={pair.number}
                    label={pair.label}
                    lines={pair.lines}
                    before={pair.before}
                    after={pair.after}
                    aspectRatio={pair.aspectRatio}
                    objectPosition={pair.objectPosition}
                    ariaName={`${group.title} ${pair.number}`}
                    priority={groupIndex === 0 && index === 0}
                  />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </main>
  <Footer disclaimer={project.disclaimer} />
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .question {
    max-width: 18ch;
  }

  .disclaimer {
    max-width: 44rem;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-ink-faint);
  }

  .stack-comparisons > * + * {
    margin-top: var(--space-2xl);
  }

  .group__header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .group__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .group__items > * + * {
    margin-top: var(--space-2xl);
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
