---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ComparisonSlider from '../components/ComparisonSlider.astro';
import { SITE } from '../data/site';
import { getFeaturedWork } from '../data/work';

const featured = getFeaturedWork()[0];
const mailto = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent('Classic title inquiry')}`;
---

<BaseLayout
  title={`${SITE.name} — Classic games. Carefully brought forward.`}
  description={SITE.description}
>
  <Header />

  <main id="main">
    <!-- MANIFESTO -->
    <section class="manifesto" aria-labelledby="manifesto-heading">
      <div class="page-shell--wide manifesto__inner">
        <h1 id="manifesto-heading" class="manifesto__claim">
          <span>Modern games</span>
          <span>are rubbish.</span>
          <span class="manifesto__period">Period.</span>
        </h1>

        <div class="manifesto__follow stack-lg">
          <p class="manifesto__prefer">
            We prefer the old ones.<br />
            But with some fresh paint on.
          </p>
          <p class="prose">
            Second Coat restores and enhances classic PC games for modern displays and
            contemporary systems — preserving the art direction, atmosphere and identity
            that made them worth remembering.
          </p>
          <a class="cta" href="#work">See what we mean ↓</a>
        </div>
      </div>
    </section>

    <!-- WORK -->
    <section id="work" class="section section--loose work" aria-labelledby="work-heading">
      <div class="page-shell--wide stack-xl">
        <header class="work__intro stack-lg">
          <div class="work__label-row">
            <span class="label">Selected Work</span>
            <span class="label">{featured.number}</span>
          </div>

          <div class="work__title-block">
            <h2 id="work-heading" class="display-lg work__title">
              {featured.title.split('\n').map((line, i, arr) => (
                <>
                  {line}
                  {i < arr.length - 1 && <br />}
                </>
              ))}
            </h2>
            <div class="work__meta">
              <span class="label label--ink">{featured.years}</span>
              <span class="label">{featured.statusLabel}</span>
            </div>
          </div>

          <div class="work__copy prose prose--tight">
            {featured.summary.map((para) => <p>{para}</p>)}
          </div>

          <p class="work__question display-md">
            {featured.question.map((line, i, arr) => (
              <>
                {line}
                {i < arr.length - 1 && <br />}
              </>
            ))}
          </p>

          <p class="work__disclaimer">{featured.disclaimer}</p>
        </header>

        <div class="work__comparisons stack-2xl">
          {
            featured.comparisonGroups.map((group, groupIndex) => (
              <section
                class="work__group stack-xl"
                aria-labelledby={`group-${group.id}`}
              >
                <header class="work__group-header">
                  <span class="label">{group.number}</span>
                  <h3 id={`group-${group.id}`} class="work__group-title">
                    {group.title}
                  </h3>
                </header>
                <div class="work__group-items stack-2xl">
                  {group.items.map((pair, index) => (
                    <ComparisonSlider
                      id={pair.id}
                      number={pair.number}
                      label={pair.label}
                      lines={pair.lines}
                      before={pair.before}
                      after={pair.after}
                      aspectRatio={pair.aspectRatio}
                      objectPosition={pair.objectPosition}
                      ariaName={`${group.title} ${pair.number}`}
                      priority={groupIndex === 0 && index === 0}
                    />
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PHILOSOPHY -->
    <section class="section section--loose philosophy" aria-labelledby="philosophy-heading">
      <div class="page-shell stack-lg">
        <h2 id="philosophy-heading" class="display-lg">
          Not remade.<br />
          Brought forward.
        </h2>
        <div class="prose">
          <p>Great old games usually don’t need a new personality.</p>
          <p>
            They need someone to remove twenty-five years of technical baggage without
            removing twenty-five years of character.
          </p>
        </div>
      </div>
    </section>

    <!-- APPROACH -->
    <section id="approach" class="section approach" aria-labelledby="approach-heading">
      <div class="page-shell--wide stack-xl">
        <div class="approach__header">
          <h2 id="approach-heading" class="label label--ink">Approach</h2>
          <hr class="rule" />
        </div>

        <ol class="approach__grid">
          <li class="approach__item">
            <p class="label">01 — Preserve</p>
            <p>
              Composition, character identity, visual language, atmosphere and
              period-specific imperfections remain the foundation.
            </p>
          </li>
          <li class="approach__item">
            <p class="label">02 — Restore</p>
            <p>
              Recover detail lost to low resolution, compression, primitive rendering
              and obsolete display technology.
            </p>
          </li>
          <li class="approach__item">
            <p class="label">03 — Enhance</p>
            <p>
              Where the original technology limited the intended result, carefully
              improve anatomy, materials, lighting and environmental detail without
              replacing the underlying art direction.
            </p>
          </li>
        </ol>

        <div class="spectrum" aria-label="Second Coat working range on the restore–enhance–remake spectrum">
          <div class="spectrum__track" aria-hidden="true">
            <span class="spectrum__point">Restore</span>
            <span class="spectrum__line">
              <span class="spectrum__active"></span>
            </span>
            <span class="spectrum__point">Enhance</span>
            <span class="spectrum__line spectrum__line--dim"></span>
            <span class="spectrum__point spectrum__point--dim">Remake</span>
          </div>
          <p class="label spectrum__caption">Second Coat works here.</p>
        </div>
      </div>
    </section>

    <!-- EDITORIAL STATEMENT -->
    <section class="section section--loose statement" aria-labelledby="statement-heading">
      <div class="page-shell stack-xl">
        <h2 id="statement-heading" class="display-lg statement__claim">
          The goal isn’t to make<br />
          a 1999 game look like<br />
          it was made in 2026.
          <span class="statement__turn">
            It’s to make it look<br />
            the way you remember it.
          </span>
        </h2>
        <div class="statement__aside">
          <p>Same world.<br />Same characters.<br />Same art direction.</p>
          <p class="statement__aside-end">No longer limited by 1999.</p>
        </div>
      </div>
    </section>

    <!-- CAPABILITIES -->
    <section class="section capabilities" aria-labelledby="capabilities-heading">
      <div class="page-shell--wide stack-xl">
        <div class="capabilities__header">
          <h2 id="capabilities-heading" class="label label--ink">Capabilities</h2>
          <hr class="rule" />
        </div>

        <dl class="capabilities__index">
          <div>
            <dt>Visual Restoration</dt>
            <dd>Portraits, environments, interface artwork, cinematics and promotional assets.</dd>
          </div>
          <div>
            <dt>Modern Displays</dt>
            <dd>Retina and high-DPI assets, modern aspect ratios and resolution-independent presentation.</dd>
          </div>
          <div>
            <dt>Modern Compatibility</dt>
            <dd>
              Preparing classic releases for contemporary systems and displays — adaptation
              for modern hardware environments without redesigning the game.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section section--loose contact" aria-labelledby="contact-heading">
      <div class="page-shell stack-xl">
        <p class="label">For Publishers / Rights Holders</p>
        <h2 id="contact-heading" class="display-lg">
          Got a great game<br />
          gathering dust?
        </h2>
        <div class="prose stack-md">
          <p>
            Second Coat works with rights holders to bring classic PC games to modern
            platforms without turning them into different games.
          </p>
          <p class="contact__list">
            Restoration.<br />
            Enhancement.<br />
            Modern compatibility.
          </p>
          <p>The original identity stays intact.</p>
        </div>
        <a class="cta cta--button" href={mailto}>Talk to Second Coat</a>
      </div>
    </section>
  </main>

  <Footer disclaimer={featured.disclaimer} />
</BaseLayout>

<style>
  .stack-2xl > * + * {
    margin-top: var(--space-2xl);
  }

  .manifesto {
    min-height: calc(100vh - var(--header-h));
    display: flex;
    align-items: flex-end;
    padding-block: clamp(2rem, 8vh, 5rem) var(--space-2xl);
  }

  .manifesto__inner {
    width: 100%;
    display: grid;
    gap: clamp(2.5rem, 7vh, 5rem);
  }

  .manifesto__claim {
    display: grid;
    gap: 0.12em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3rem, 11vw, 8.6rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    max-width: 14ch;
  }

  .manifesto__period {
    color: var(--color-ink-muted);
    font-size: 0.4em;
    letter-spacing: 0.16em;
    margin-top: 0.45em;
    font-weight: 600;
  }

  .manifesto__follow {
    max-width: 34rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
  }

  .manifesto__prefer {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    line-height: 1.3;
    color: var(--color-ink);
  }

  .work__label-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .work__title-block {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 800px) {
    .work__title-block {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 2rem;
    }
  }

  .work__meta {
    display: grid;
    gap: 0.45rem;
  }

  @media (min-width: 800px) {
    .work__meta {
      text-align: right;
    }
  }

  .work__copy {
    max-width: 40rem;
  }

  .work__question {
    max-width: 18ch;
    padding-top: var(--space-lg);
  }

  .work__disclaimer {
    max-width: 44rem;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-ink-faint);
  }

  .work__group-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .work__group-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .philosophy .prose {
    max-width: 34rem;
  }

  .approach__header,
  .capabilities__header {
    display: grid;
    gap: 0.85rem;
  }

  .approach__grid {
    display: grid;
    gap: var(--space-xl);
    counter-reset: none;
  }

  @media (min-width: 900px) {
    .approach__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .approach__item {
    display: grid;
    gap: 1rem;
    padding-top: 0.25rem;
  }

  .approach__item p:last-child {
    color: var(--color-ink-muted);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 28rem;
  }

  .spectrum {
    display: grid;
    gap: 1rem;
    padding-top: var(--space-lg);
  }

  .spectrum__track {
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
  }

  .spectrum__point {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .spectrum__point--dim {
    color: var(--color-ink-faint);
  }

  .spectrum__line {
    position: relative;
    height: 1px;
    background: var(--color-rule);
    overflow: hidden;
  }

  .spectrum__active {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
  }

  .spectrum__line--dim {
    opacity: 0.55;
  }

  .spectrum__caption {
    color: var(--color-ink-muted);
  }

  .statement__claim {
    max-width: 14ch;
  }

  .statement__turn {
    display: block;
    margin-top: 1.1em;
    color: var(--color-ink-muted);
  }

  .statement__aside {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--color-ink-muted);
    max-width: 16rem;
  }

  .statement__aside-end {
    margin-top: 1.25rem;
    color: var(--color-ink);
  }

  .capabilities__index {
    display: grid;
    gap: 0;
  }

  .capabilities__index > div {
    display: grid;
    gap: 0.65rem;
    padding-block: 1.35rem;
    border-top: 1px solid var(--color-rule);
  }

  @media (min-width: 800px) {
    .capabilities__index > div {
      grid-template-columns: minmax(12rem, 18rem) 1fr;
      gap: 2rem;
      align-items: baseline;
    }
  }

  .capabilities__index > div:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .capabilities__index dt {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .capabilities__index dd {
    margin: 0;
    color: var(--color-ink-muted);
    max-width: 40rem;
    line-height: 1.6;
  }

  .contact__list {
    color: var(--color-ink) !important;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.45;
  }

  @media (max-width: 640px) {
    .spectrum__track {
      grid-template-columns: 1fr;
      gap: 0.55rem;
      text-align: left;
    }

    .spectrum__line {
      width: 100%;
    }
  }
</style>
